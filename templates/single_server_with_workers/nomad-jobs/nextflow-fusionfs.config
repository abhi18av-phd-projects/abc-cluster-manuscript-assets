// nextflow-fusionfs.config
//
// nf-nomad config for FusionFS workdir validation on single-server-with-workers.
// Use instead of (or in addition to) the base NFS config when testing
// the FusionFS storage strategy for the nf-nomad paper.
//
// Prerequisites:
//   1. MinIO running as a Nomad job: nomad job run minio.nomad.hcl
//   2. nf-work bucket created: mc mb seedling/nf-work
//   3. Seqera Wave token set: export NXF_WAVE_TOKEN=<token>
//      (or configure wave.endpoint for self-hosted Wave)
//   4. NXF_VER=25.10.5 — FusionFS requires NF >= 23.x; pinned for nf-nomad compat.
//
// Run command (from host, current provision: client-0 = 192.168.252.18):
//   NXF_VER=25.10.5 \
//   NXF_HOME=/opt/nf-work \
//   AWS_ACCESS_KEY_ID=minioadmin \
//   AWS_SECRET_ACCESS_KEY=minioadmin \
//   NXF_WAVE_TOKEN=$TOWER_ACCESS_TOKEN \
//   nextflow run nf-core/demo \
//     -r dev -profile test \
//     -c /opt/nf-test/nextflow.config \
//     -c /opt/nf-test/nextflow-fusionfs.config \
//     --outdir /opt/nf-test/results/nf-core-demo-fusion
//
// Note: config files are applied left-to-right; this file's settings override
// the base config where keys overlap (workDir, process.scratch).
// TOWER_ACCESS_TOKEN: Seqera platform token — set in shell before running.
// Wave endpoint defaults to wave.seqera.io; no wave.endpoint override needed.

plugins {
  id 'nf-nomad@0.4.0-edge3'
}

// FusionFS: Seqera's FUSE-based virtual filesystem over S3.
// Containers do not need S3 credentials mounted — FusionFS intercepts
// POSIX calls and translates them to S3 API requests transparently.
// No NFS mount required; no host volume needed for task work dirs.
fusion {
  enabled                  = true
  exportStorageCredentials = true  // injects AWS creds into task containers
}

// Wave: Seqera's container augmentation service.
// Required by FusionFS to inject the fusion-agent sidecar into task containers.
// Set NXF_WAVE_TOKEN env var to authenticate; or configure wave.endpoint for
// a self-hosted Wave instance.
wave {
  enabled = true
}

// S3 work directory — FusionFS mounts this as a virtual path inside containers.
// MinIO bucket must exist before running the pipeline.
// Note: must be a subdirectory within the bucket (not the bucket root).
// nf-amazon's S3FileSystemProvider.createDirectory does putObject with a trailing "/",
// which MinIO rejects when the key resolves to empty or "/". Using s3://nf-work/work
// avoids the bucket-root edge case.
workDir = "s3://nf-work/work"

// process.scratch = false: FusionFS provides the working directory directly
// via the virtual mount. Setting scratch = true would cause Nextflow to create
// a local temp dir and copy outputs, defeating FusionFS's purpose.
process {
  scratch = false
}

// Override igenomes_base to a local path — required when FusionFS redirects all
// S3 ops to MinIO. nf-schema 2.7.x validates the default value of igenomes_base
// (s3://ngi-igenomes/igenomes/) even when igenomes_ignore=true, which hits our
// MinIO endpoint and fails with 404. A local dummy path passes format validation
// without an S3 stat. The pipeline doesn't use igenomes (igenomes_ignore=true).
params {
  igenomes_base  = '/tmp/igenomes'
  igenomes_ignore = true
}

// AWS/MinIO credentials for Nextflow head node → MinIO API calls.
// Individual task containers get credentials injected via fusion.exportStorageCredentials.
// Replace MINIO_CLIENT_IP with the actual client-0 IP after reprovisioning.
aws {
  accessKey = "minioadmin"
  secretKey = "minioadmin"
  client {
    // MinIO endpoint — must be reachable from both head node and task containers.
    // Containers run on Nomad clients with network access to the MinIO port.
    endpoint          = "http://192.168.252.18:9000"
    s3PathStyleAccess = true  // MinIO requires path-style (not virtual-hosted-style)
  }
}

// nf-nomad already injects AWS_S3_ENDPOINT into task containers from aws.client.endpoint,
// so the Nextflow env {} scope is not needed for the MinIO endpoint.
// NOTE: the Nextflow env {} scope is NOT forwarded to Nomad task envs by nf-nomad 0.4.0-edge3.
// nf-nomad handles it directly from aws.client.endpoint.

// FusionFS requires /dev/fuse inside the task container to mount the virtual S3 filesystem.
// By default, Docker containers do not have /dev/fuse access. nf-nomad 0.4.0-edge3 sets
// privileged=false for FusionFS containers (despite forcing privileged=true for plain Docker
// tasks). Without privileged mode, the FusionFS agent exits 174 with "mounting filesystem
// error: no such file or directory".
// Override: force privileged=true so the Docker task has /dev/fuse accessible.
nomad {
  jobs {
    privileged = true
  }
}
