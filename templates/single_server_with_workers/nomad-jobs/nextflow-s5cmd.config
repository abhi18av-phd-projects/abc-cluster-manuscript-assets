// nextflow-s5cmd.config
//
// ⚠ STATUS: DRAFT — NOT YET RUNNABLE (2026-05-12)
//
// This config is a placeholder for the nf-nomad-s5cmd distributed workdir strategy.
// It CANNOT be used until the following unmerged PR on nf-nomad is merged:
//
//   nf-nomad PR: adds DistributedWorkdirProviderFactory SPI
//   (the PF4J extension point that nf-nomad-s5cmd implements)
//
// Without that PR, nf-nomad has no knowledge of the DistributedWorkdirProvider
// interface, and the nf-nomad-s5cmd plugin cannot register its implementation.
// The plugin loads but the nomad.s5cmd config scope is silently ignored.
//
// Infrastructure already in place on single-server-with-workers (2026-05-12):
//   ✓ s5cmd v2.2.2 at /opt/nf-work/bin/s5cmd (NFS share, accessible from containers)
//   ✓ s5cmd also at /usr/local/bin/s5cmd on client-0 and client-1
//   ✓ nf-nomad-s5cmd-0.1.0.jar extracted into /opt/nf-work/plugins/nf-nomad-s5cmd-0.1.0/classes/
//   ✓ MinIO running as Nomad job on client-0 (192.168.252.18:9000)
//   ✓ nf-work bucket created: mc mb seedling/nf-work
//
// Once the nf-nomad PR merges, remove this header and run:
//   NXF_VER=25.10.5 \
//   NXF_HOME=/opt/nf-work \
//   AWS_ACCESS_KEY_ID=minioadmin \
//   AWS_SECRET_ACCESS_KEY=minioadmin \
//   nextflow run nf-core/demo \
//     -r dev -profile test \
//     -c /opt/nf-test/nextflow.config \
//     -c /opt/nf-test/nextflow-s5cmd.config \
//     --outdir /opt/nf-test/results/nf-core-demo-s5cmd
//
// ─────────────────────────────────────────────────────────────────────────────
//
// nf-nomad-s5cmd config for distributed-workdir validation on single-server-with-workers.
// Tests S3 staging via s5cmd as the workdir strategy — tasks run on Nomad workers
// without a shared filesystem requirement; all file transfers go through MinIO.
//
// Architecture (three-phase staging via s5cmd):
//   1. Pre-submission (head, client-0): uploads .command.* + inputs to s3://nf-work/s5cmd-sessions/
//   2. Task execution (worker container): bootstrap script downloads files, runs task, uploads outputs
//   3. Post-completion (head): polls .exitcode, copies artifacts back to local workDir
//
// Unlike FusionFS (FUSE virtual mount), nf-s5cmd uses s5cmd CLI invocations in the bootstrap
// script — no FUSE, no privileged containers required.

// Both plugins declared here because Nextflow's plugins {} block does not
// merge across config files — the last file's block replaces earlier ones.
// nf-nomad must be listed first so its classloader is available when
// nf-nomad-s5cmd's @Extension classes are loaded.
plugins {
  id 'nf-nomad@0.4.0-edge3'
  id 'nf-nomad-s5cmd@0.1.0'
}

// workDir: LOCAL path on head node — nf-s5cmd copies artifacts back here after S3 staging.
// Using /opt/nf-work/s5cmd-runs keeps results on the NFS share (visible from host).
// This is NOT an S3 path — the S3 staging bucket is in nomad.s5cmd.workDir.bucket below.
workDir = '/opt/nf-work/s5cmd-runs'

// igenomes_base: nf-schema 2.7.x validates the default s3://ngi-igenomes/igenomes/ on
// startup. Override with a local path to skip the S3 stat.
params {
  igenomes_base   = '/tmp/igenomes'
  igenomes_ignore = true
}

// nf-nomad-s5cmd config (canonical scope: nomad.s5cmd since plugin rename)
nomad {
  s5cmd {
    enabled = true

    // s5cmd binary inside task containers. Accessible via the 'nf-work' host_volume
    // mount (declared in host-volumes.hcl on each client, mounted at /opt/nf-work).
    binary = '/opt/nf-work/bin/s5cmd'

    // S3 connection to local MinIO.
    s3 {
      endpoint        = 'http://192.168.252.18:9000'
      region          = 'us-east-1'
      accessKeyId     = 'minioadmin'
      secretAccessKey = 'minioadmin'
      usePathStyle    = true   // required for MinIO path-style URLs
      useTLS          = false  // no TLS on local MinIO
    }

    // Distributed workdir: S3 staging for worker tasks.
    // The bucket holds per-task staging dirs; the head copies outputs back to workDir above.
    workDir {
      enabled           = true
      bucket            = 's3://nf-work'
      prefix            = 's5cmd-sessions/'
      completionTimeout = '120s'
    }
  }
}
